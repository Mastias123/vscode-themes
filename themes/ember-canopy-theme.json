    "breadcrumb.activeSelectionForeground": "#F0A03E",
    "minimap.background": "#1A1009",
    "minimap.selectionHighlight": "#75451F99",
    "minimap.findMatchHighlight": "#E99232AA",
    "peekView.border": "#C77B2D",
    "peekViewEditor.background": "#201208",
    "peekViewResult.background": "#24150B",
    "peekViewResult.selectionBackground": "#55321A",
    "peekViewTitle.background": "#36200F",

    "gitDecoration.addedResourceForeground": "#91B873",
    "gitDecoration.modifiedResourceForeground": "#E3A044",
    "gitDecoration.deletedResourceForeground": "#DC7258",
    "gitDecoration.renamedResourceForeground": "#B7B56F",
    "gitDecoration.untrackedResourceForeground": "#76AC8B",
    "gitDecoration.ignoredResourceForeground": "#7B6652",
    "gitDecoration.conflictingResourceForeground": "#E18455",
    "diffEditor.insertedTextBackground": "#5A7A4A44",
    "diffEditor.removedTextBackground": "#7B342444",
    "diffEditor.insertedLineBackground": "#3D573133",
    "diffEditor.removedLineBackground": "#56251833"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9A8466", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and control flow",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#EF9835" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#D8B46A" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#D8803B" }
    },
    {
      "name": "Functions and calls",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#F0C16F" }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.interface", "support.type", "support.class"],
      "settings": { "foreground": "#AEC98B" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#E2D1AF" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#A8C386" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#B99B70" }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json", "string.json support.type.property-name.json"],
      "settings": { "foreground": "#B8CA8B" }
    },
    {
      "name": "HTML and JSX tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#E68A35" }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#B4C987" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": { "foreground": "#B2C784" }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css", "support.constant.property-value.scss"],
      "settings": { "foreground": "#D5A65B" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#F0A03E", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold and links",
      "scope": ["markup.bold", "markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#9EC7A0", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFE0CB", "background": "#783127" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A6B878",
    "class": "#B6CD91",
    "class.declaration": { "foreground": "#C6DDA1", "bold": true },
    "interface": "#AFC98D",
    "struct": "#B6CD91",
    "enum": "#D0BC74",
    "enumMember": "#E0A255",
    "type": "#B6CD91",
    "typeParameter": "#C5D89C",
    "function": "#F0C16F",
    "method": "#E9B765",
    "property": "#AAC787",
    "variable": "#E2D1AF",
    "parameter": "#D8C29A",
    "keyword": "#EF9835",
    "modifier": "#E78136",
    "string": "#D8B46A",
    "number": "#D8803B",
    "regexp": "#82B69A",
    "operator": "#B99B70",
    "comment": { "foreground": "#9A8466", "italic": true },
    "decorator": "#A9C57F",
    "*.readonly": { "foreground": "#D9B66E" },
    "*.defaultLibrary": { "foreground": "#94B998" }
  }
}
