    "terminal.ansiYellow": "#D59A48",
    "terminal.ansiBlue": "#609A8A",
    "terminal.ansiMagenta": "#B17B68",
    "terminal.ansiCyan": "#69A99A",
    "terminal.ansiWhite": "#DCC8A4",
    "terminal.ansiBrightBlack": "#88694C",
    "terminal.ansiBrightRed": "#EE8367",
    "terminal.ansiBrightGreen": "#A7C486",
    "terminal.ansiBrightYellow": "#F0B75C",
    "terminal.ansiBrightBlue": "#87C1AD",
    "terminal.ansiBrightMagenta": "#D09C86",
    "terminal.ansiBrightCyan": "#91CCB9",
    "terminal.ansiBrightWhite": "#FFF0CE",

    "input.background": "#2A190E",
    "input.foreground": "#E2D1AF",
    "input.border": "#704727",
    "input.placeholderForeground": "#91735A",
    "inputOption.activeBorder": "#E99232",
    "inputOption.activeBackground": "#5B2C0E99",
    "dropdown.background": "#2A190E",
    "dropdown.foreground": "#E2D1AF",
    "dropdown.border": "#704727",
