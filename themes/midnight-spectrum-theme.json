    "tab.inactiveBackground": "#101725",
    "tab.inactiveForeground": "#8394A9",
    "tab.hoverBackground": "#1E2B42",
    "tab.hoverForeground": "#D8E5F5",
    "tab.activeBorderTop": "#56B6F2",
    "tab.border": "#0B101A",

    "activityBar.background": "#0D1422",
    "activityBar.foreground": "#7DC7F5",
    "activityBar.inactiveForeground": "#64748B",
    "activityBar.border": "#24334A",
    "activityBar.activeBorder": "#F6AD55",
    "activityBar.activeBackground": "#15233A",
    "activityBarBadge.background": "#F6AD55",
