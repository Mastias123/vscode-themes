    "terminal.background": "#0F1725",
    "terminal.foreground": "#D8E5F5",
    "terminalCursor.foreground": "#F6AD55",
    "terminal.ansiBlack": "#111827",
    "terminal.ansiRed": "#EF6B7B",
    "terminal.ansiGreen": "#4ADE80",
    "terminal.ansiYellow": "#FCD34D",
    "terminal.ansiBlue": "#56B6F2",
    "terminal.ansiMagenta": "#C084FC",
    "terminal.ansiCyan": "#2DD4BF",
    "terminal.ansiWhite": "#D8E5F5",
    "terminal.ansiBrightBlack": "#64748B",
    "terminal.ansiBrightRed": "#FB7185",
    "terminal.ansiBrightGreen": "#86EFAC",
    "terminal.ansiBrightYellow": "#FDE68A",
    "terminal.ansiBrightBlue": "#93C5FD",
    "terminal.ansiBrightMagenta": "#D8B4FE",
    "terminal.ansiBrightCyan": "#5EEAD4",
    "terminal.ansiBrightWhite": "#F1F5F9",

    "input.background": "#172235",
    "input.foreground": "#D8E5F5",
    "input.border": "#31445E",
    "input.placeholderForeground": "#71839A",
    "inputOption.activeBorder": "#56B6F2",
    "inputOption.activeBackground": "#1B426B99",
    "dropdown.background": "#172235",
    "dropdown.foreground": "#D8E5F5",
    "dropdown.border": "#31445E",
    "button.background": "#2563A3",
    "button.foreground": "#F8FBFF",
    "button.hoverBackground": "#3376B9",
    "button.secondaryBackground": "#263A55",
    "button.secondaryForeground": "#D8E5F5",
    "button.secondaryHoverBackground": "#344B6A",

    "list.activeSelectionBackground": "#26486C",
    "list.activeSelectionForeground": "#F3F8FF",
    "list.inactiveSelectionBackground": "#1D3048",
