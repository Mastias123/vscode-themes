    "scrollbar.shadow": "#080C14",
    "scrollbarSlider.background": "#45637C66",
    "scrollbarSlider.hoverBackground": "#5A7C9977",
    "scrollbarSlider.activeBackground": "#79A9D188",
    "menu.background": "#152033",
    "menu.foreground": "#D8E5F5",
