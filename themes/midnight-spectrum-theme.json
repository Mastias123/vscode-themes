    "quickInput.background": "#152033",
    "quickInput.foreground": "#D8E5F5",
    "quickInputList.focusBackground": "#26486C",

    "breadcrumb.foreground": "#91A5BC",
    "breadcrumb.focusForeground": "#D8E5F5",
    "breadcrumb.activeSelectionForeground": "#56B6F2",
    "minimap.background": "#111827",
    "minimap.selectionHighlight": "#28527A88",
    "minimap.findMatchHighlight": "#F6AD5599",
    "peekView.border": "#56B6F2",
    "peekViewEditor.background": "#111C2D",
    "peekViewResult.background": "#142033",
    "peekViewResult.selectionBackground": "#26486C",
    "peekViewTitle.background": "#1B2940",

    "gitDecoration.addedResourceForeground": "#70D99B",
    "gitDecoration.modifiedResourceForeground": "#7DC7F5",
    "gitDecoration.deletedResourceForeground": "#F47A8B",
    "gitDecoration.renamedResourceForeground": "#C9A7FA",
    "gitDecoration.untrackedResourceForeground": "#4ADE80",
    "gitDecoration.ignoredResourceForeground": "#718096",
    "gitDecoration.conflictingResourceForeground": "#F6AD55",
    "diffEditor.insertedTextBackground": "#2E8B5744",
    "diffEditor.removedTextBackground": "#A63D4A44",
    "diffEditor.insertedLineBackground": "#235B3A33",
    "diffEditor.removedLineBackground": "#6D283333"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6F849C", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and control flow",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#F6AD55" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#86EFAC" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#FCD34D" }
    },
    {
      "name": "Functions and calls",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#7DC7F5" }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.interface", "support.type", "support.class"],
      "settings": { "foreground": "#70D99B" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#D8E5F5" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#78D7C2" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "name": "JSON property names",
      "scope": ["support.type.property-name.json", "string.json support.type.property-name.json"],
      "settings": { "foreground": "#7DD3FC" }
    },
    {
      "name": "HTML and JSX tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#F6AD55" }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#86EFAC" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": { "foreground": "#7DD3FC" }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css", "support.constant.property-value.scss"],
      "settings": { "foreground": "#86EFAC" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#F6AD55", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold and links",
      "scope": ["markup.bold", "markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7DD3FC", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFF1F2", "background": "#8A3140" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#70D99B",
    "class": "#86EFAC",
    "class.declaration": { "foreground": "#A7F3C3", "bold": true },
    "interface": "#78D7C2",
    "struct": "#86EFAC",
    "enum": "#FCD34D",
    "enumMember": "#F6AD55",
    "type": "#86EFAC",
    "typeParameter": "#A7F3C3",
    "function": "#7DC7F5",
    "method": "#93C5FD",
    "property": "#78D7C2",
    "variable": "#D8E5F5",
    "parameter": "#B8CCE0",
    "keyword": "#F6AD55",
    "modifier": "#FB923C",
    "string": "#86EFAC",
    "number": "#FCD34D",
    "regexp": "#5EEAD4",
    "operator": "#C4B5FD",
    "comment": { "foreground": "#6F849C", "italic": true },
    "decorator": "#C084FC",
    "*.readonly": { "foreground": "#F6AD55" },
    "*.defaultLibrary": { "foreground": "#56B6F2" }
  }
}
